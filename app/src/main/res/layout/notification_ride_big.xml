<?xml version="1.0" encoding="utf-8"?>
<!-- Notificação de corrida aceita, expandida: título, busca → viagem, mapa e até 5 linhas de detalhe
     (overlay/RideNotifier). Altura total cabe no limite do Android para notificação personalizada. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/ride_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <TextView
        android:id="@+id/ride_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />

    <ImageView
        android:id="@+id/ride_map"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginTop="4dp"
        android:contentDescription="Mapa da corrida: você, coleta (A) e destino (B)"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ride_map_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ride_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ride_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ride_line3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ride_line4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ride_line5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
